# Copie para .env.local (dev) ou configure como variáveis de ambiente no
# painel do host (Railway/Render). Nenhum valor real aqui — apenas exemplos.

# --- Servidor ---
NODE_ENV=production
PORT=3000

# --- App / sessão ---
# Identificador livre do app (usado só pra assinar o JWT de sessão).
VITE_APP_ID=sistemas-buddha-spa
# Segredo usado pra assinar/verificar o cookie de sessão (JWT HS256).
# Gere um valor aleatório longo, ex.: openssl rand -base64 48
JWT_SECRET=

# --- Banco de dados (TiDB / MySQL) ---
DATABASE_URL=mysql://usuario:senha@host:4000/nome_do_banco

# --- Login (Google OAuth — único fluxo de login em uso) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- IA (OpenAI, usado pelos Agentes de Atendimento, sugestão de resposta,
#     transcrição de áudio e geração de imagem) ---
OPENAI_API_KEY=

# --- Armazenamento de arquivos (Cloudflare R2, compatível com S3) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Google Sheets (relatórios/planilhas) ---
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# --- Telegram (avisos e relatório diário) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_GRUPO_RECEPCAO=
TELEGRAM_CHAT_ID_GUILHERME=

# --- Opcional (webhook de aviso de deploy, ver server/webhooks.ts) ---
DEPLOY_WEBHOOK_TOKEN=

# --- Opcional (acesso somente leitura de Claude ao banco via
#     POST /api/claude-consulta, ver server/claudeQueryRoute.ts) ---
# Gere um valor aleatório longo, ex.: openssl rand -base64 48
CLAUDE_QUERY_TOKEN=

# --- Opcional ---
# Promove automaticamente esse openId a admin na primeira vez que o banco é
# criado. Sem efeito se os usuários já existirem — pode deixar em branco.
OWNER_OPEN_ID=
